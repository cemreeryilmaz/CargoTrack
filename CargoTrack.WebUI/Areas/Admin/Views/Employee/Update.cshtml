@model UpdateEmployeeDto
@{
    ViewData["Title"] = "Personel Düzenle";
}

<h3 class="mb-3">Personel Düzenle</h3>

<form method="post" style="max-width:560px">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Ad</label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Soyad</label>
            <input asp-for="LastName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Unvan</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Şube</label>
            <select asp-for="BranchId" class="form-select" asp-items="@ViewBag.Branches"></select>
        </div>
        <div class="col-md-6 form-check ms-2 mt-3">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label class="form-check-label">Aktif</label>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-dark">Güncelle</button>
        <a href="/Admin/Employee/Index" class="btn btn-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
