@model CreateEmployeeDto
@{
    ViewData["Title"] = "Yeni Personel";
}

<h3 class="mb-3">Yeni Personel</h3>

<form method="post" style="max-width:560px">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Ad</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Soyad</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Unvan</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Şube</label>
            <select asp-for="BranchId" class="form-select" asp-items="@ViewBag.Branches">
                <option value="">-- Şube Seçiniz --</option>
            </select>
            <span asp-validation-for="BranchId" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-dark">Kaydet</button>
        <a href="/Admin/Employee/Index" class="btn btn-secondary">Vazgeç</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
