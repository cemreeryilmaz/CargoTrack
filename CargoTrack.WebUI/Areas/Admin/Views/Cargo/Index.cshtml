@model PagedResult<ResultCargoDto>
@{
    ViewData["Title"] = "Kargolar";
    var filter = ViewBag.Filter as CargoFilterDto ?? new CargoFilterDto();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Tüm Kargolar</h3>
    <a href="/Admin/Cargo/Create" class="btn btn-dark">Yeni Kargo Oluştur</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="Search" value="@filter.Search" class="form-control" placeholder="Takip No ara..." />
    </div>
    <div class="col-md-3">
        <select name="Status" class="form-select">
            <option value="">-- Tüm Durumlar --</option>
            @foreach (CargoStatus s in Enum.GetValues(typeof(CargoStatus)))
            {
                if (filter.Status == s)
                {
                    <option value="@((int)s)" selected>@s.GetDisplayName()</option>
                }
                else
                {
                    <option value="@((int)s)">@s.GetDisplayName()</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="DeliveryType" class="form-select">
            <option value="">-- Teslimat Tipi --</option>
            @foreach (DeliveryType d in Enum.GetValues(typeof(DeliveryType)))
            {
                if (filter.DeliveryType == d)
                {
                    <option value="@((int)d)" selected>@d.GetDisplayName()</option>
                }
                else
                {
                    <option value="@((int)d)">@d.GetDisplayName()</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-primary">Filtrele</button>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Takip No</th>
            <th>Gönderici</th>
            <th>Alıcı</th>
            <th>Rota</th>
            <th>Durum</th>
            <th>Ücret</th>
            <th>Tahmini</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Items)
        {
            <tr>
                <td>@c.TrackCode</td>
                <td>@c.SenderFullName</td>
                <td>@c.ReceiverFullName</td>
                <td>@c.OriginBranchName → @c.DestinationBranchName</td>
                <td>
                    <span class="badge bg-secondary">@c.CargoStatusName</span>
                    @if (c.IsDelayed)
                    {
                        <span class="badge bg-danger">Gecikmiş</span>
                    }
                </td>
                <td>@c.Price.ToString("N2") ₺</td>
                <td>@c.EstimatedArrivalDate.ToString("dd.MM.yyyy")</td>
                <td>
                    <a href="/Admin/Cargo/Detail/@c.Id" class="btn btn-info btn-sm">Detay</a>
                    <a href="/Admin/Cargo/Update/@c.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a href="/Admin/Cargo/Delete/@c.Id" onclick="return confirm('Silmek istediğinize emin misiniz?')" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="8" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
</table>

@{
    string PageUrl(int p) => $"/Admin/Cargo/Index?Page={p}&PageSize={filter.PageSize}&Search={filter.Search}&Status={(filter.Status.HasValue ? ((int)filter.Status).ToString() : "")}&DeliveryType={(filter.DeliveryType.HasValue ? ((int)filter.DeliveryType).ToString() : "")}";
}
<nav>
    <ul class="pagination">
        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link" href="@PageUrl(Model.Page - 1)">Önceki</a>
        </li>
        <li class="page-item disabled"><span class="page-link">@Model.Page / @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span></li>
        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link" href="@PageUrl(Model.Page + 1)">Sonraki</a>
        </li>
    </ul>
</nav>
