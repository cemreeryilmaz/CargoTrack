@model List<ResultTransferCenterDto>
@{
    ViewData["Title"] = "Transfer Merkezleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Transfer Merkezleri</h3>
    <a href="/Admin/TransferCenter/Create" class="btn btn-dark">Yeni Transfer Merkezi</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr><th>#</th><th>Ad</th><th>Şehir</th><th>İşlemler</th></tr>
    </thead>
    <tbody>
        @{ int i = 0; }
        @foreach (var t in Model)
        {
            i++;
            <tr>
                <td>@i</td>
                <td>@t.Name</td>
                <td>@t.CityName</td>
                <td>
                    <a href="/Admin/TransferCenter/Update/@t.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a href="/Admin/TransferCenter/Delete/@t.Id" onclick="return confirm('Emin misiniz?')" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
