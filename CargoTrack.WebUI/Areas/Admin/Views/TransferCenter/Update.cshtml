@model UpdateTransferCenterDto
@{
    ViewData["Title"] = "Transfer Merkezi Düzenle";
}

<h3 class="mb-3">Transfer Merkezi Düzenle</h3>

<form method="post" style="max-width:480px">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label">Ad</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Şehir</label>
        <select asp-for="CityId" class="form-select" asp-items="@ViewBag.Cities"></select>
    </div>
    <button type="submit" class="btn btn-dark">Güncelle</button>
    <a href="/Admin/TransferCenter/Index" class="btn btn-secondary">Vazgeç</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
