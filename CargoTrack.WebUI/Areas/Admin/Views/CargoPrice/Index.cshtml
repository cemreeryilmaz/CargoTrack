@model List<ResultCargoPriceDto>
@{
    ViewData["Title"] = "Fiyat Kuralları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Fiyat Kuralları</h3>
    <a href="/Admin/CargoPrice/Create" class="btn btn-dark">Yeni Fiyat Kuralı</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Ad</th><th>Teslimat Tipi</th><th>Taban</th><th>Kg Ücreti</th>
            <th>Desi Ücreti</th><th>Şehir Farkı</th><th>Durum</th><th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.DeliveryTypeName</td>
                <td>@p.BasePrice.ToString("N2") ₺</td>
                <td>@p.PricePerKg.ToString("N2") ₺</td>
                <td>@p.PricePerDesi.ToString("N2") ₺</td>
                <td>@p.DifferentCityFee.ToString("N2") ₺</td>
                <td>
                    @if (p.IsActive)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>
                    <a href="/Admin/CargoPrice/Update/@p.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a href="/Admin/CargoPrice/Delete/@p.Id" onclick="return confirm('Emin misiniz?')" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
