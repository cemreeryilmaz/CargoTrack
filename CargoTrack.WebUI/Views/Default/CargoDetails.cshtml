@model CargoTrackingDto
@{
    ViewData["Title"] = "Gönderi Detayları";
    Layout = "~/Views/UILayout/Index.cshtml";

    // Rota şehirlerini sıralı derle (ardışık tekrarları ele)
    var routeCities = new List<string>();
    void AddCity(string? c)
    {
        if (string.IsNullOrWhiteSpace(c)) return;
        var t = c.Trim();
        if (routeCities.Count == 0 || !routeCities[^1].Equals(t, StringComparison.OrdinalIgnoreCase))
            routeCities.Add(t);
    }
    AddCity(Model.OriginCityName);
    foreach (var mv in Model.Movements) AddCity(mv.City);
    AddCity(Model.DestinationCityName);
}

<style>
    .timeline-line::before {
        content: '';
        position: absolute;
        left: 11px;
        top: 24px;
        bottom: -24px;
        width: 2px;
        background-color: #E2E8F0;
        z-index: 0;
    }
    .timeline-item:last-child .timeline-line::before { display: none; }
</style>

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-primary-container mb-2">Gönderi Detayları</h1>
        <p class="text-on-surface-variant font-body-md">Gönderinizin güncel durumunu ve hareket geçmişini inceleyin.</p>
    </div>
    <a href="/Default/Index" class="flex items-center justify-center gap-2 bg-secondary-container text-on-secondary px-6 py-2.5 rounded-lg font-semibold hover:bg-opacity-90 transition-colors shadow-sm">
        <span class="material-symbols-outlined">search</span>
        Yeni Kargo Sorgula
    </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left: Main Info -->
    <div class="lg:col-span-8 flex flex-col gap-6">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 flex flex-col md:flex-row gap-8">
            <div class="flex-1 border-r-0 md:border-r border-outline-variant/30 pr-0 md:pr-6">
                <div class="mb-6">
                    <p class="font-label-caps text-label-caps text-outline mb-1 uppercase">Takip Numarası</p>
                    <h2 class="font-headline-md text-headline-md text-primary-container">@Model.TrackCode</h2>
                </div>
                <div class="inline-flex items-center gap-1.5 bg-surface-container-high text-primary-container px-3 py-1 rounded-full font-status-label text-status-label mb-6">
                    <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                    @Model.CargoStatusName
                </div>
                <div class="flex gap-8">
                    <div>
                        <p class="text-sm text-outline mb-1">Gönderim Tarihi</p>
                        <p class="font-semibold text-on-background">@Model.ShipmentDate.ToString("dd MMMM yyyy")</p>
                    </div>
                    <div>
                        <p class="text-sm text-outline mb-1">Tahmini Teslimat</p>
                        <p class="font-semibold text-on-background">@Model.EstimatedArrivalDate.ToString("dd MMMM yyyy")</p>
                    </div>
                </div>
            </div>
            <!-- Journey -->
            <div class="flex-1 flex flex-col justify-center">
                <div class="flex justify-between items-center mb-2">
                    <div class="flex flex-col items-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center mb-2 text-primary-container">
                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">location_on</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.OriginCityName</span>
                        <span class="text-xs text-outline">@Model.OriginBranchName</span>
                    </div>
                    <div class="flex-grow flex items-center px-2">
                        <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                        <div class="flex-grow h-px bg-outline-variant relative">
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-surface-container-lowest px-2">
                                <span class="material-symbols-outlined text-secondary-container" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                            </div>
                        </div>
                        <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                    </div>
                    <div class="flex flex-col items-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container text-outline flex items-center justify-center mb-2">
                            <span class="material-symbols-outlined text-[18px]">flag</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.DestinationCityName</span>
                        <span class="text-xs text-outline">@Model.DestinationBranchName</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Canlı Harita Takibi -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-symbols-outlined text-primary-container">map</span>
                <h3 class="font-headline-md text-xl text-primary-container">Canlı Harita Takibi</h3>
            </div>
            <p class="text-sm text-outline mb-4">Gönderinizin izlediği güzergâh ve güncel konumu.</p>
            @await Html.PartialAsync("_CargoRouteMap", routeCities)
            <div class="flex flex-wrap gap-4 mt-4 text-xs text-outline">
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-gray-500 inline-block"></span> Çıkış</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-blue-600 inline-block"></span> Ara Durak</span>
                <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-green-600 inline-block"></span> Güncel Konum</span>
            </div>
        </div>
    </div>

    <!-- Right: Timeline -->
    <div class="lg:col-span-4">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 h-full">
            <div class="flex items-center gap-2 mb-6 pb-4 border-b border-outline-variant/30">
                <span class="material-symbols-outlined text-primary-container">history</span>
                <h3 class="font-headline-md text-xl text-primary-container">Kargo Hareketleri</h3>
            </div>
            <div class="relative">
                @if (Model.Movements.Any())
                {
                    @foreach (var m in Model.Movements)
                    {
                        <div class="timeline-item relative pb-8 pl-10">
                            <div class="timeline-line"></div>
                            <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-green-500 text-white flex items-center justify-center z-10 ring-4 ring-white">
                                <span class="material-symbols-outlined text-[14px] font-bold">check</span>
                            </div>
                            <p class="font-semibold text-on-background mb-1">@m.NewStatusName</p>
                            <div class="flex items-center gap-1 text-sm text-outline">
                                <span class="material-symbols-outlined text-[16px]">location_on</span>
                                @(m.DisplayLocation ?? "-") • @m.MovementDate.ToString("dd MMM, HH:mm")
                            </div>
                            @if (!string.IsNullOrEmpty(m.Description))
                            {
                                <p class="text-xs text-on-surface-variant mt-1">@m.Description</p>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-sm text-outline">Henüz hareket kaydı bulunmuyor.</p>
                }
            </div>
        </div>
    </div>
</div>
