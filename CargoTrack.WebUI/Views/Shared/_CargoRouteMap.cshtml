@model List<string>
@{
    // Rota şehirleri (sıralı). JSON olarak JS'e aktarılır.
    var routeJson = System.Text.Json.JsonSerializer.Serialize(Model ?? new List<string>());
    var mapId = "cargoRouteMap_" + Guid.NewGuid().ToString("N");
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div id="@mapId" style="height: 380px; width: 100%;" class="rounded-xl z-0 bg-surface-container"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
    // Türkiye il koordinatları (lat, lng)
    const CITY_COORDS = {
        "Adana":[37.00,35.32],"Adıyaman":[37.76,38.28],"Afyonkarahisar":[38.76,30.54],"Ağrı":[39.72,43.05],
        "Amasya":[40.65,35.83],"Ankara":[39.93,32.85],"Antalya":[36.90,30.70],"Artvin":[41.18,41.82],
        "Aydın":[37.84,27.84],"Balıkesir":[39.65,27.88],"Bilecik":[40.14,29.98],"Bingöl":[38.88,40.50],
        "Bitlis":[38.40,42.11],"Bolu":[40.74,31.61],"Burdur":[37.72,30.29],"Bursa":[40.19,29.06],
        "Çanakkale":[40.15,26.41],"Çankırı":[40.60,33.62],"Çorum":[40.55,34.95],"Denizli":[37.78,29.09],
        "Diyarbakır":[37.91,40.24],"Edirne":[41.68,26.56],"Elazığ":[38.68,39.22],"Erzincan":[39.75,39.49],
        "Erzurum":[39.90,41.27],"Eskişehir":[39.78,30.52],"Gaziantep":[37.07,37.38],"Giresun":[40.91,38.39],
        "Gümüşhane":[40.46,39.48],"Hakkari":[37.57,43.74],"Hatay":[36.20,36.16],"Isparta":[37.76,30.55],
        "Mersin":[36.81,34.64],"İstanbul":[41.01,28.98],"İzmir":[38.42,27.14],"Kars":[40.60,43.10],
        "Kastamonu":[41.38,33.78],"Kayseri":[38.73,35.49],"Kırklareli":[41.73,27.22],"Kırşehir":[39.14,34.17],
        "Kocaeli":[40.77,29.92],"Konya":[37.87,32.48],"Kütahya":[39.42,29.98],"Malatya":[38.35,38.31],
        "Manisa":[38.61,27.43],"Kahramanmaraş":[37.58,36.93],"Mardin":[37.31,40.74],"Muğla":[37.22,28.36],
        "Muş":[38.74,41.49],"Nevşehir":[38.62,34.71],"Niğde":[37.97,34.68],"Ordu":[40.98,37.88],
        "Rize":[41.02,40.52],"Sakarya":[40.69,30.44],"Samsun":[41.29,36.33],"Siirt":[37.93,41.94],
        "Sinop":[42.03,35.15],"Sivas":[39.75,37.02],"Tekirdağ":[40.98,27.51],"Tokat":[40.31,36.55],
        "Trabzon":[41.00,39.72],"Tunceli":[39.11,39.55],"Şanlıurfa":[37.17,38.79],"Uşak":[38.68,29.41],
        "Van":[38.49,43.41],"Yozgat":[39.82,34.81],"Zonguldak":[41.45,31.79],"Aksaray":[38.37,34.03],
        "Bayburt":[40.26,40.22],"Karaman":[37.18,33.22],"Kırıkkale":[39.85,33.52],"Batman":[37.88,41.13],
        "Şırnak":[37.52,42.46],"Bartın":[41.63,32.34],"Ardahan":[41.11,42.70],"Iğdır":[39.92,44.04],
        "Yalova":[40.65,29.28],"Karabük":[41.20,32.63],"Kilis":[36.72,37.12],"Osmaniye":[37.07,36.25],
        "Düzce":[40.84,31.16]
    };

    // Türkçe/ASCII il adlarını eşlemek için diyakritikleri sadeleştiren normalize
    function norm(s) {
        return String(s).trim()
            .replace(/İ/g, "i").replace(/ı/g, "i").replace(/I/g, "i")
            .replace(/Ş/g, "s").replace(/ş/g, "s")
            .replace(/Ğ/g, "g").replace(/ğ/g, "g")
            .replace(/Ü/g, "u").replace(/ü/g, "u")
            .replace(/Ö/g, "o").replace(/ö/g, "o")
            .replace(/Ç/g, "c").replace(/ç/g, "c")
            .toLowerCase();
    }

    const NORM = {};
    for (const k in CITY_COORDS) { NORM[norm(k)] = CITY_COORDS[k]; }

    const route = @Html.Raw(routeJson);
    const points = [];
    const labels = [];
    (route || []).forEach(function (name) {
        if (!name) return;
        const c = NORM[norm(name)];
        if (c) { points.push(c); labels.push(name); }
    });

    function initMap() {
        const el = document.getElementById("@mapId");
        if (!el || typeof L === "undefined") return;

        const map = L.map("@mapId", { scrollWheelZoom: false });
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 18,
            attribution: "&copy; OpenStreetMap"
        }).addTo(map);

        if (points.length === 0) {
            map.setView([39.0, 35.0], 5); // Türkiye geneli
            return;
        }

        // Rota çizgisi
        if (points.length > 1) {
            L.polyline(points, { color: "#2563eb", weight: 4, opacity: 0.8, dashArray: "8,6" }).addTo(map);
        }

        const lastIdx = points.length - 1;
        points.forEach(function (p, i) {
            const isLast = i === lastIdx;
            const isFirst = i === 0;
            const color = isLast ? "#16a34a" : (isFirst ? "#6b7280" : "#2563eb");
            const radius = isLast ? 10 : 7;
            const marker = L.circleMarker(p, {
                radius: radius, color: "#fff", weight: 2,
                fillColor: color, fillOpacity: 1
            }).addTo(map);
            let title = labels[i];
            if (isLast) title = "📍 Güncel Konum: " + title;
            else if (isFirst) title = "Çıkış: " + title;
            marker.bindPopup("<b>" + title + "</b>");
            if (isLast) marker.openPopup();
        });

        const bounds = L.latLngBounds(points);
        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 9 });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMap);
    } else {
        initMap();
    }
})();
</script>
